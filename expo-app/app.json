{
  "expo": {
    "name": "Nina Control Room",
    "slug": "nina-control-room",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nina.controlroom"
    },
    "android": {
      "package": "com.nina.controlroom",
      "permissions": [
        "INTERNET"
      ],
      "allowBackup": false
    },
    "plugins": [
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ]
    ]
  }
}
